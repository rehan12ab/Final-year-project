# ========================================
# Backend Environment Variables (HackSentinel)
# ========================================
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env — it contains secrets.

# --- Server ---
PORT=5000

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/hacksentinel
MONGO_DB_NAME=hacksentinel

# --- Auth ---
# Use a long random string (>= 64 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# --- Google Gemini (AI chat / insights) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Python Scan API (Model A / passive scan) ---
PYTHON_API_URL=http://localhost:8000

# --- Firebase (optional, for phone OTP) ---
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=

# --- Mailgun (optional, for email OTP) ---
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=

# --- Frontend origin (production; dev allows all) ---
# CLIENT_ORIGIN=https://your-frontend-domain.vercel.app
